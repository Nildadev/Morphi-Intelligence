# Morphi Intelligence environment template.
# Copy to .env and fill in locally. Never commit real secrets.

# Token shared between the Electron host and the server process.
MORPHI_TOKEN=

# Model used to generate session titles ("auto" resolves from provider priority).
MORPHI_TITLE_MODEL=auto

# Provider API keys. In the packaged app, keys are entered in Settings and
# stored with the OS keyring via the Electron preload bridge; these variables
# are the dev-mode fallback.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
CEREBRAS_API_KEY=
TOGETHER_API_KEY=

# NVIDIA NIM (https://build.nvidia.com) and Kilo Gateway (https://kilo.ai). Both are
# OpenAI-compatible gateways whose /models listing carries no metadata, so their context
# windows, tool support and effort levels come from the bundled models.dev snapshot in
# server/src/harness/llm/providerCatalog.ts.
NVIDIA_API_KEY=
KILO_API_KEY=

# DeepSeek Chat — the local bridge from https://github.com/sums001/Deepseek-API. It turns the
# chat.deepseek.com account you sign into into an OpenAI-compatible endpoint on
# http://127.0.0.1:8000/v1; no key is needed (the bridge authenticates with the browser
# session it manages), so this variable is an optional dev-mode override only. Run it with
# `python app.py` in a clone of that repo.
DEEPSEEK_CHAT_API_KEY=
