{
  "name": "morphi-intelligence",
  "version": "1.1.0",
  "description": "Roblox Studio AI Orchestrator",
  "main": "main.js",
  "author": "Phuc",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "packageManager": "npm@10",
  "scripts": {
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "build": "npm run build:client && npm run build:server",
    "postinstall": "node scripts/sqlite-abi.mjs cache",
    "prestart": "node scripts/sqlite-abi.mjs electron",
    "start": "electron .",
    "predev": "node scripts/sqlite-abi.mjs node",
    "test": "npm run test:server && npm run test:client",
    "test:server": "npm --prefix server test",
    "test:client": "npm --prefix client test",
    "test:main": "node --test \"main/*.test.js\"",
    "e2e": "npm --prefix client run e2e",
    "typecheck": "npm --prefix server run typecheck && npm --prefix server run typecheck:tests && npm --prefix client run build",
    "lint": "npm --prefix client run lint",
    "dist": "npm run build && electron-builder",
    "predist": "node scripts/sqlite-abi.mjs electron",
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\""
  },
  "build": {
    "appId": "com.morphi.intelligence",
    "productName": "Morphi Intelligence",
    "compression": "store",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "main/**/*.js",
      "!main/**/*.test.js",
      "logo.png",
      "package.json",
      "server/dist/**/*",
      "server/*.json",
      "client/dist/**/*",
      "node_modules/**/*",
      "!node_modules/{@types,typescript,vite,electron,electron-builder}/**/*",
      "!**/node_modules/*/{README.md,test,docs,examples,changelog.md,LICENSE}*"
    ],
    "win": {
      "target": "portable",
      "icon": "logo.png"
    }
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-is-dev": "^2.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.2.4",
    "express": "^5.2.1"
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
